# OpenCode Proxy Configuration

# API Keys (pisahkan dengan koma jika multiple)
# Contoh: API_KEYS=sk-xxxxx,sk-yyyyy,sk-zzzzz
API_KEYS=

# Provider Base URLs (opsional - jika menggunakan provider lain)
# OpenAI compatible (Termasuk OpenRouter, Together, dll)
OPENAI_API_BASE=https://api.openai.com

# Anthropic
ANTHROPIC_API_BASE=https://api.anthropic.com

# Port (otomatis di-set oleh Railway)
PORT=3000